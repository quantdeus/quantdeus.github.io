{
  "schema_version": 1,
  "policy_id": "quantdeus-public-safety",
  "version": "2026.10-qshield-v1",
  "scope": [
    "telegram-public-chat",
    "openclaw-public-chat",
    "website-chat"
  ],
  "public_access": {
    "private_chat": "open_to_all_users",
    "group_chat": "commands_mentions_and_replies_only",
    "admin_allowlist_required_for_chat": false,
    "mutations_from_public_chat": false
  },
  "principles": [
    "human agency and consent",
    "privacy and secret protection",
    "instruction hierarchy integrity",
    "external and quoted content is untrusted data",
    "public chat is tool-less and non-privileged",
    "evidence discipline and no fabricated actions",
    "fail closed on prompt injection, secret exfiltration and privilege escalation"
  ],
  "enforcement_layers": [
    "unicode normalization and deterministic input classifier",
    "system-level injection firewall",
    "OpenClaw public tools deny-all",
    "output secret leakage filter",
    "group-message addressing gate",
    "contract tests in CI"
  ]
}
