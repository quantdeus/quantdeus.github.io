    ".github/workflows/openclaw-evolution.yml"
  ],
  "protected_invariants": [
    "github-oidc-authentication",
    "trusted-workflow-gating",
    "public-no-tools",
    "mcp-deny-lists",
    "secret-isolation",
    "branch-pr-auditability",
    "qa-and-static-smoke",
    "mission-alignment",
    "human-approval-for-privileged-actions"
  ],
  "metrics": [
    "workflow-success-rate",
    "trusted-mcp-tool-success",
    "model-failover-reliability",
    "doctor-lint-findings",
    "mean-recovery-time",
    "failure-recurrence",
    "tool-call-efficiency",
    "observable-latency"
  ],
  "history": [
    {
      "date": "2026-09-29",
      "type": "bootstrap",
      "hypothesis": "A repository-backed, prompt-injected evolution skill plus a daily evidence loop can improve OpenClaw behavior without allowing core self-merge.",
      "status": "pending-production-validation"
    },
    {
      "date": "2026-09-30",
      "type": "enforcement-hardening",
      "hypothesis": "Move evolution GitHub writes behind deterministic pre-mutation validation, make Tier B proposal-only, and require independent successful QA, Smoke, and semantic/path guard checks before Tier A merge.",
