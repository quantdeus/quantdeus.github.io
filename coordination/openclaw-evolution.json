    "max_prs_per_cycle": 1,
    "max_changed_files": 3,
    "evidence_required": true,
    "direct_main_write": false,
    "core_auto_merge": false,
    "auto_merge": false,
    "human_review_required": true,
    "analysis_tools": false,
    "mutation_broker": "scripts/openclaw-evolution.js",
