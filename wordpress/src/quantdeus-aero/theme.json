{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {"contentSize": "760px", "wideSize": "1280px"},
    "color": {"defaultPalette": false, "palette": [
      {"slug":"horizon-ink","name":"Horizon Ink","color":"#073646"},
      {"slug":"aero-cyan","name":"Aero Cyan","color":"#5fdaef"},
      {"slug":"aero-sky","name":"Aero Sky","color":"#c9f6ff"},
      {"slug":"aero-green","name":"Aero Green","color":"#7ce5a4"},
      {"slug":"horizon-violet","name":"Horizon Violet","color":"#8f7bea"},
      {"slug":"cloud","name":"Cloud","color":"#f7feff"}
    ]},
    "spacing": {"units": ["px","rem","em","%","vw","vh"]},
    "typography": {"fluid": true, "fontSizes": [
      {"slug":"small","size":"0.875rem","name":"Small"},
      {"slug":"medium","size":"1rem","name":"Medium"},
      {"slug":"large","size":"clamp(1.35rem,2vw,1.75rem)","name":"Large"},
      {"slug":"x-large","size":"clamp(2rem,5vw,4.8rem)","name":"Display"}
    ]}
  },
  "styles": {
    "typography": {"fontFamily":"Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif","lineHeight":"1.6"},
    "elements": {"link": {"color":{"text":"#0b7288"},"typography":{"textDecoration":"none"}}}
  }
}
