    {"step":"installPlugin","pluginData":{"resource":"bundled","path":"/assets/quantdeus-core.zip"},"options":{"activate":true}},
    {"step":"installTheme","themeData":{"resource":"bundled","path":"/assets/quantdeus-aero.zip"},"options":{"activate":true}},
    {"step":"setSiteOptions","options":{"blogname":"QuantDeus","blogdescription":"Технологии · Исследования · Медиа · Сообщество","permalink_structure":"/%postname%/"}},
    {"step":"runPHP","code":"<?php require_once '/wordpress/wp-load.php'; if (class_exists('QD_Core')) { QD_Core::activate(); } flush_rewrite_rules(false);"},
