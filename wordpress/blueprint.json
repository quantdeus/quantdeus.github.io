{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "features": {
    "networking": true
  },
  "steps": [
    {
      "step": "defineWpConfigConsts",
      "consts": {
        "WP_DEBUG": true,
        "WP_DEBUG_LOG": true,
        "WP_DEBUG_DISPLAY": false,
        "QD_TELEGRAM_CLIENT_ID": "8122160274",
        "QD_TELEGRAM_BOT_USERNAME": "QuantDeus_bot"
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "git:directory",
        "url": "https://github.com/quantdeus/quantdeus.github.io.git",
        "ref": "main",
        "refType": "branch",
        "path": "wordpress/src/quantdeus-core"
      },
      "options": {
        "activate": true,
        "targetFolderName": "quantdeus-core"
      }
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "git:directory",
        "url": "https://github.com/quantdeus/quantdeus.github.io.git",
        "ref": "main",
        "refType": "branch",
        "path": "wordpress/src/quantdeus-aero"
      },
      "options": {
        "activate": true,
        "targetFolderName": "quantdeus-aero"
      }
    },
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "QuantDeus",
        "blogdescription": "Технологии · Исследования · Медиа · Сообщество",
        "permalink_structure": "/%postname%/"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require_once '/wordpress/wp-load.php'; if (class_exists('QD_Core')) { QD_Core::activate(); } flush_rewrite_rules(false);"
    },
    {
      "step": "login",
      "username": "admin"
    }
  ]
}
